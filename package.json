{
  "name": "hworktime",
  "version": "4.2.0",
  "private": true,
  "description": "HWorkTime on GitHub Pages",
  "scripts": {
    "prepare": "node scripts/hooks/install-hooks.cjs",
    "prepare:site": "vite build && node scripts/site/prepare-site.cjs",
    "preview:site": "vite preview --outDir _site --base /HWorkTime/ --host 127.0.0.1 --port 4173 --strictPort",
    "prepare:reader": "node scripts/reader/prepare-reader.cjs",
    "prepare:vocabulary": "node scripts/vocabulary/prepare-vocabulary.cjs",
    "check:vocabulary": "node scripts/verify/vocabulary/verify-vocabulary.cjs",
    "check:reader": "node scripts/verify/media/verify-reader.cjs",
    "check:release": "pnpm run check && pnpm run lint && pnpm run check:format && pnpm run prepare:site && node scripts/verify/site/verify-release.cjs",
    "generate:locales": "node scripts/i18n/generate-locales.cjs && prettier --write \"assets/js/locales/**/*.js\" && pnpm run prepare:assets",
    "test": "pnpm run check",
    "check": "node scripts/site/check-site.cjs && pnpm run typecheck",
    "lint": "eslint src assets/js scripts tools eslint.config.cjs --max-warnings 0",
    "format:css": "node scripts/site/clean-css.cjs",
    "format:source": "prettier --write \"assets/js/**/*.js\" \"scripts/**/*.cjs\" \"tools/**/*.js\" eslint.config.cjs \"src/**/*.{ts,tsx}\" vite.config.mjs \"src/styles/*.css\"",
    "check:format": "prettier --check \"assets/js/**/*.js\" \"scripts/**/*.cjs\" \"tools/**/*.js\" eslint.config.cjs \"src/**/*.{ts,tsx}\" vite.config.mjs \"src/styles/*.css\"",
    "prepare:assets": "node scripts/site/prepare-assets.cjs",
    "typecheck": "tsc -p jsconfig.json && tsc --noEmit",
    "aeroplane:train": "node scripts/aeroplane/cli.cjs train",
    "aeroplane:resume": "node scripts/aeroplane/cli.cjs resume",
    "aeroplane:evaluate": "node scripts/aeroplane/cli.cjs evaluate",
    "aeroplane:export": "node scripts/aeroplane/cli.cjs export",
    "aeroplane:test": "node scripts/verify/games/verify-aeroplane.cjs",
    "uno:train": "node scripts/uno/cli.cjs train",
    "uno:resume": "node scripts/uno/cli.cjs resume",
    "uno:evaluate": "node scripts/uno/cli.cjs evaluate",
    "uno:export": "node scripts/uno/cli.cjs export",
    "prepare:speech": "node scripts/vocabulary/prepare-speech.cjs",
    "package:speech": "node scripts/vocabulary/package-speech.cjs",
    "check:speech": "node scripts/vocabulary/verify-speech.cjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@tabler/icons": "3.53.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@typescript-eslint/parser": "8.74.0",
    "@vitejs/plugin-react": "5",
    "acorn": "8.18.0",
    "clean-css": "5.3.3",
    "epubjs": "0.3.93",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "jszip": "3.10.2",
    "onnxruntime-web": "1.22.0",
    "opencc-js": "1.0.5",
    "pdfjs-dist": "6.5.438",
    "phonemizer": "1.2.1",
    "playwright": "1.62.1",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "terser": "5.51.2",
    "ts-fsrs": "5.4.2",
    "typescript": "5.9.3",
    "vite": "7"
  },
  "dependencies": {
    "antd": "6",
    "react": "19",
    "react-dom": "19"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.9.12"
    }
  }
}
